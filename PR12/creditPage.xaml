<Page x:Class="PR12.creditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="creditPage">

        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="10">
                <TextBlock Text="Настройка кредита" FontSize="18" Margin="0,0,0,20"/>

                <TextBlock Text="Процент первоначального взноса:" FontSize="16" Margin="0,0,0,10"/>
                <Slider x:Name="depositSlider" Minimum="0" Maximum="100" ValueChanged="Slider_ValueChanged"/>
                <TextBlock x:Name="depositPercentText" FontSize="16" Margin="0,5,0,20" Text="0 %"/>

                <TextBlock Text="Срок кредита (месяцы):" FontSize="16" Margin="0,0,0,10"/>
                <Slider x:Name="termSlider" Minimum="12" Maximum="96" TickFrequency="12" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                <TextBlock x:Name="termText" FontSize="16" Margin="0,5,0,20" Text="12 мес."/>
            </StackPanel>

        <StackPanel Grid.Column="1" Margin="30,1,0,0">
            <TextBlock Text="Итоговый расчёт" FontSize="18" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Стоимость автомобиля:" FontSize="16" Width="200"/>
                <TextBlock x:Name="carPriceText" FontSize="16"/>
                <TextBlock Text=" ₽" FontSize="16"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Первоначальный взнос:" FontSize="16" Width="200"/>
                <TextBlock x:Name="depositAmountText" FontSize="16"/>
                <TextBlock Text=" ₽" FontSize="16"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Сумма кредита:" FontSize="16" Width="200"/>
                <TextBlock x:Name="loanAmountText" FontSize="16"/>
                <TextBlock Text=" ₽" FontSize="16"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Срок:" FontSize="16" Width="200"/>
                <TextBlock x:Name="termAmountText" FontSize="16"/>
                <TextBlock Text=" мес." FontSize="16"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Ежемесячный платёж:" FontSize="16" Width="200"/>
                <TextBlock x:Name="monthlyPaymentText" FontSize="16"/>
                <TextBlock Text=" ₽" FontSize="16"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,30" HorizontalAlignment="Center">
                <Button Content="Назад" Width="120" Height="40" Click="back_Click"/>
                <Button Content="Далее" Width="120" Height="40" Margin="20,0" Click="next_Click"/>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</Page>
