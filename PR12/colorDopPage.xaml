<Page x:Class="PR12.colorDopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="colorDopPage">

    <Grid>
        <StackPanel>
            <TextBlock Text="Выбор цвета и дополнительных опций" FontSize="18" HorizontalAlignment="Center" Margin="20"/>

            <TextBlock Text="Автомобиль:" FontSize="16" Margin="35,5,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="35,5,0,0">
                <RadioButton x:Name="toyotaRB" Content="Toyota" FontSize="15" Margin="7" Checked="car_Checked"/>
                <RadioButton x:Name="mazdaRB" Content="Mazda" FontSize="15" Margin="7" Checked="car_Checked"/>
                <RadioButton x:Name="bmwRB" Content="BMW" FontSize="15" Margin="7" Checked="car_Checked"/>
            </StackPanel>

            <TextBlock Text="Цвет:" FontSize="16" Margin="35,15,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="35,5,0,0">
                <RadioButton x:Name="whiteRB" Content="Белый" FontSize="15" Margin="7" Checked="color_Checked"/>
                <RadioButton x:Name="blackRB" Content="Чёрный" FontSize="15" Margin="7" Checked="color_Checked"/>
                <RadioButton x:Name="serebroRB" Content="Серебристый" FontSize="15" Margin="7" Checked="color_Checked"/>
                <RadioButton x:Name="blueRB" Content="Тёмно-синий" FontSize="15" Margin="7" Checked="color_Checked"/>
                <RadioButton x:Name="pinkRB" Content="Розовый" FontSize="15" Margin="7" Checked="color_Checked"/>
            </StackPanel>

            <Grid Margin="35,30,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Дополнительные опции:" FontSize="16"/>
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="tonChckBx" Content="Тонировка (+8500₽)" FontSize="15" Margin="7" Checked="OptionChanged" Unchecked="OptionChanged"/>
                    <CheckBox x:Name="signChckBx" Content="Сигнализация (+15000₽)" FontSize="15" Margin="7" Checked="OptionChanged" Unchecked="OptionChanged"/>
                    <CheckBox x:Name="anticorChckBx" Content="Антикоррозийная обработка (+12000₽)" FontSize="15" Margin="7" Checked="OptionChanged" Unchecked="OptionChanged"/>
                    <CheckBox x:Name="wheelsChckBx" Content="Зимние колёса (+13000₽)" FontSize="15" Margin="7" Checked="OptionChanged" Unchecked="OptionChanged"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,30" HorizontalAlignment="Center">
                <Button x:Name="backButton" Content="Назад" Width="120" Height="40" Click="back_Click"/>
                <Button x:Name="nextButton" Content="Далее" Width="120" Height="40" Margin="20,0" Click="next_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
