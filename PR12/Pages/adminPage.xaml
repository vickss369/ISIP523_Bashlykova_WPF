<Page x:Class="PR12.Pages.adminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="adminPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Background="#5C72A3 ">
            <TextBlock x:Name="managerNameTBl" Text="ФИО админа" FontSize="21" FontWeight="Bold" Foreground="#3A2119" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="logoutBtn" Content="→ Выход" FontSize="17" Height="40" Width="100" Background="#C94736" Foreground="#3A2119" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,20,0" Click="logoutBtn_Click"/>
        </Grid>

        <Grid Grid.Row="1">

        </Grid>
    </Grid>
</Page>
