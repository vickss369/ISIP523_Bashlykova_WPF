<Page x:Class="PR12.Pages.clientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="clientPage">

    <Grid>
        <Border BorderBrush="#3A2119" BorderThickness="2" CornerRadius="10" Background="#D9CBC2" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="600" MaxHeight="600">
            <Grid>
                <StackPanel>
                    <Button x:Name="logoutBtn" Content="→ Выход" FontSize="17" Height="40" Width="100" Background="#C94736" Foreground="#3A2119" HorizontalAlignment="Right" Margin="0,20,20,0" Click="logoutBtn_Click"/>
                </StackPanel>

                <StackPanel Margin="40,35">
                    <TextBlock Text="{Binding FullName, StringFormat='Добро пожаловать, {0}!'}" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,50,0,15" Foreground="#3A2119"/>
                    <TextBlock Text="С чего начнём?" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#3A2119"/>

                    <StackPanel>
                        <Button x:Name="toRecordBtn" Content="Записаться" FontSize="17" Width="160" Height="50" Margin="0,0,0,17" Background="#B4776E" HorizontalAlignment="Center" VerticalAlignment="Center" Click="toRecordBtn_Click"/>
                        <Button x:Name="toProductBtn" Content="Каталог товаров" FontSize="17" Width="160" Height="50" Margin="0,0,0,17" Background="#989876" HorizontalAlignment="Center" VerticalAlignment="Center" Click="toProductBtn_Click"/>
                        <Button x:Name="toAccountBtn" Content="Аккаунт" FontSize="17" Width="160" Height="50" Margin="0,0,0,17" Background="#1B6C7E" HorizontalAlignment="Center" VerticalAlignment="Center" Click="toAccountBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
