<Page x:Class="PR12.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="MainPage">

    <Grid>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Салон «я упала с самосвала тормозила головой»" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" Margin="20,0,20,30" Foreground="#442D1C"/>
            <TextBlock Text="ГЛАВНАЯ СТРАНИЦА" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" Margin="40" Foreground="#442D1C"/>
            <Button x:Name="goToStartBtn" Content="На стартовую страницу" FontSize="17" Height="50" Width="210" HorizontalAlignment="Center" Background="#6B212C" Foreground="#D9CBC2" Click="goToStartBtn_Click"/>
            <Button x:Name="registrBtn" Content="Вход / регистрация" FontSize="17" Height="50" Width="210" HorizontalAlignment="Center" Margin="20" Background="#3C507D" Foreground="#D9CBC2" Click="registrBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
