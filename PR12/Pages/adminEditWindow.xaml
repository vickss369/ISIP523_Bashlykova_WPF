<Window x:Class="PR12.Pages.adminEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR12.Pages"
        mc:Ignorable="d"
        Background="#D2E2EC"
        Title="Редактирование" MinHeight="450" MinWidth="700"
        Height="500" Width="750">

    <Grid>
        <Border BorderBrush="#3A2119" BorderThickness="2" CornerRadius="10" Background="#D9CBC2" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="600" MaxHeight="440">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="titleTBl" Text="Редактирование" FontSize="20" FontWeight="Bold" Foreground="#3A2119" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,10,0,0"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="25">
                        <TextBlock x:Name="usernameTBl" Text="ФИО пользователя" FontSize="16" Foreground="#3A2119"/>
                        <TextBox x:Name="usernameTB" FontSize="15" Height="30" Margin="0,0,0,17"/>

                        <TextBlock x:Name="roleTBl" Text="Роль" FontSize="16" Foreground="#3A2119"/>
                        <ComboBox x:Name="roleCB" FontSize="15" Height="30" Margin="0,0,0,17" DisplayMemberPath="Name" SelectedValuePath="ID"/>

                        <TextBlock x:Name="phoneNumberTBl" Text="Номер телефона" FontSize="16" Foreground="#3A2119"/>
                        <TextBox x:Name="phoneNumberTB" FontSize="15" Height="30" Margin="0,0,0,17"/>

                        <CheckBox x:Name="isFreezeChB" Content="Заморожен" FontSize="15" Foreground="#3A2119" Margin="0,5,0,17"/>

                        <TextBlock x:Name="loginTBl" Text="Логин" FontSize="16" Foreground="#3A2119"/>
                        <TextBox x:Name="loginTB" FontSize="15" Height="30" Margin="0,0,0,15"/>

                        <TextBlock x:Name="passwordTBl" Text="Пароль" FontSize="16" Foreground="#3A2119"/>
                        <TextBox x:Name="passwordTB" FontSize="15" Height="30" Margin="0,0,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <Button x:Name="saveBtn" Content="Сохранить" FontSize="16" Width="110" Height="40" Background="#1B6C7E" Margin="5" Grid.Row="2" Click="saveBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
