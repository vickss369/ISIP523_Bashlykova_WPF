<Window x:Class="PR12.Pages.chosenProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PR12.Pages"
        mc:Ignorable="d"
        Background="#D2E2EC"
        Title="Выбранный товар" MinHeight="500" MinWidth="700"
        Height="450" Width="800">

    <Grid>
        <Border Margin="25" Padding="25" BorderBrush="#3A2119" BorderThickness="2" CornerRadius="12" Background="#D9CBC2" MaxWidth="650" MaxHeight="350">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#C4A39C" BorderBrush="#3A2119" BorderThickness="2" CornerRadius="8" Padding="5">
                    <Image Source="{Binding ImagePath}" Width="260" Height="260"  Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="25,0,0,0">
                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" Foreground="#3A2119" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}" FontSize="15" Foreground="#3A2119" TextWrapping="Wrap" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding ProductType.Name, StringFormat=Тип: {0}}" FontSize="16" Foreground="#3A2119" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Manufacturer.Name, StringFormat=Производитель: {0}}" FontSize="16" Foreground="#3A2119" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Price, StringFormat=Цена: {0}₽}" FontSize="18" FontWeight="Bold" Foreground="#3A2119" Margin="0,10,0,20"/>

                    <Button x:Name="addToBasketBtn" Content="В корзину" FontSize="16" Width="110" Height="40" Margin="9" Background="#C59767" BorderBrush="#3A2119" Click="addToBasketBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
