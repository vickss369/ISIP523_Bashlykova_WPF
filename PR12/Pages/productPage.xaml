<Page x:Class="PR12.Pages.productPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="productPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#5C72A3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Товары" FontSize="20" FontWeight="Bold" Foreground="#3A2119" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="100,0,0,0"/>
            <Button x:Name="toClientMenuBtn" Content="Назад" FontSize="17" Width="100" Height="40" Grid.Column="0" HorizontalAlignment="Left" Margin="20,0,0,0" Background="#A86A65" Foreground="#3A2119" Click="backToClientMenu_Click"/>
            <Button x:Name="toBasketBtn" Content="Корзина" FontSize="17" Width="100" Height="40" Grid.Column="1" Margin="25,0,30,0" Background="#A86A65" Foreground="#3A2119" Click="toBasketBtn_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="10">
                <TextBlock Text="Поиск" FontSize="17"/>
                <TextBox x:Name="searchTB" Height="35" FontSize="16" HorizontalAlignment="Stretch" TextChanged="SearchTB_TextChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="10">
                <TextBlock Text="Тип" FontSize="17"/>
                <ComboBox x:Name="typeCB" Height="35" FontSize="16" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="TypeCB_Changed"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="10">
                <TextBlock Text="Производитель" FontSize="17"/>
                <ComboBox x:Name="manufacturerCB" Height="35" FontSize="16" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="ManufacturerCB_Changed"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Margin="10">
                <TextBlock Text="Сортировка" FontSize="17"/>
                <ComboBox x:Name="sortCB" Height="35" FontSize="16" HorizontalAlignment="Stretch" SelectionChanged="SortCB_Changed">
                    <ComboBoxItem Content="Без сортировки"/>
                    <ComboBoxItem Content="По цене ↑"/>
                    <ComboBoxItem Content="По цене ↓"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <ListBox x:Name="productsList" Grid.Row="2" BorderThickness="0" Background="#D2E2EC" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="300" Height="470" Margin="10" Padding="10" BorderBrush="#3A2119" BorderThickness="1" CornerRadius="8" Background="{Binding CardColor}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="320"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Image Source="{Binding ImagePath}" Width="270" Height="320" Stretch="UniformToFill"/>
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Price, StringFormat=Цена: {0}₽}" FontSize="14" Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button x:Name="toDetailsBtn" Content="Подробнее" Width="110" Height="40" Margin="5" Background="#8BA2C1" Foreground="#2F3E46" Click="toProductDetailsBtn_Click"/>
                                <Button x:Name="addToBasketBtn" Content="В корзину" Width="110" Height="40" Margin="5" Background="#C4A39C" Foreground="#3A2119" Click="addToBasketBtn_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
