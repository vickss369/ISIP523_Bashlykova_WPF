<Page x:Class="PR12.Pages.basketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="basketPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#5C72A3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Корзина" FontSize="20" FontWeight="Bold" Foreground="#3A2119" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"/>
            <Button Content="← В каталог" Width="110" Height="40" FontSize="16" Margin="50,0,50,0" HorizontalAlignment="Right" Background="#989876" BorderBrush="#3A2119" Click="backToCatalog_Click"/>
        </Grid>

        <ListBox x:Name="basketItems" Grid.Row="1"  HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="#D2E2EC" Margin="0,20,0,0" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#3A2119" BorderThickness="1" CornerRadius="8" MaxWidth="500" MaxHeight="200" Padding="10" Margin="0,5" Background="#EBCDB7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding Product.ImagePath}" Width="85" Height="85" Grid.Column="0"/>
                            <StackPanel Grid.Column="1" Margin="10">
                                <TextBlock Text="{Binding Product.Name}" FontSize="17" FontWeight="Bold" Foreground="#3A2119"/>
                                <TextBlock Text="{Binding Product.Price, StringFormat=Цена: {0}₽}" FontSize="15" Foreground="#3A2119"/>
                                <TextBlock Text="{Binding Quantity, StringFormat=Количество: {0}}" FontSize="15" Foreground="#3A2119"/>
                                <TextBlock Text="{Binding Total, StringFormat=Сумма: {0}₽}" FontSize="15" FontWeight="Bold" Margin="0,6,0,0" Foreground="#3A2119"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="+" Width="30" Height="25" FontSize="15" Margin="0,2,9,10" Background="#95CA72" BorderBrush="#3A2119" Click="increase_Click"/>
                                    <Button Content="-" Width="30" Height="25" FontSize="15" Margin="0,2,0,10" Background="#C94736" BorderBrush="#3A2119" Click="decrease_Click"/>
                                </StackPanel>
                                <Button Content="Удалить" Width="70" Height="30" FontSize="15" Margin="0,5,0,0" Background="#C3948D" BorderBrush="#3A2119" Click="removeItem_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Vertical">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="130,5,0,0">
                <TextBlock Text="Общая сумма:" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,1"/>
                <TextBlock x:Name="totalPriceTB" FontSize="17" Margin="5,5,0,6"/>
            </StackPanel>

            <Button Content="Оформить заказ" FontSize="17" Width="155" Height="45" Margin="130,10,0,20" HorizontalAlignment="Left" Background="#8BA2C1" BorderBrush="#3A2119" Click="order_Click"/>
        </StackPanel>
    </Grid>
</Page>
