<Page x:Class="PR12.Pages.basketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="basketPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#5C72A3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Корзина" FontSize="20" FontWeight="Bold" Foreground="#3A2119" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10"/>
            <Button Content="Каталог" Width="100" Height="40" FontSize="16" Margin="50,0,50,0" HorizontalAlignment="Right" Background="#A86A65" BorderBrush="#3A2119" Click="backToCatalog_Click"/>
        </Grid>

        <ListBox x:Name="basketItems" Grid.Row="1" BorderThickness="0" HorizontalContentAlignment="Center" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="#D2E2EC" Margin="0,20,0,0" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#3A2119" BorderThickness="1" CornerRadius="8" Width="350" Height="100" Padding="10" Margin="0,5" HorizontalAlignment="Center" Background="#EBCDB7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding ImagePath}" Width="80" Height="80" Grid.Column="0"/>
                            <StackPanel Grid.Column="1" Margin="13,5">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Foreground="#3A2119"/>
                                <TextBlock Text="{Binding Price, StringFormat=Цена: {0}₽}" FontSize="14" Margin="0,5,0,0" Foreground="#3A2119"/>
                            </StackPanel>
                            
                            <Button Content="Удалить" FontSize="14" Width="70" Height="35" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" Background="#C15344" BorderBrush="#3A2119" Click="removeItem_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Vertical">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="130,10,0,0">
                <TextBlock Text="Общая сумма:" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,1" Foreground="#000000"/>
                <TextBlock x:Name="totalPriceTB" FontSize="17" Margin="5,5,0,6" Foreground="#000000"/>
            </StackPanel>
            
            <Button Content="Оформить заказ" FontSize="17" Width="155" Height="45" Margin="130,10,0,20" HorizontalAlignment="Left" Background="#989876" BorderBrush="#3A2119" Click="order_Click"/>
        </StackPanel>
    </Grid>
</Page>
