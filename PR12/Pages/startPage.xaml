<Page x:Class="PR12.Pages.startPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="startPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#5C72A3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Услуги" FontSize="20" FontWeight="Bold" Foreground="#3A2119" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="80,0,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                <Button x:Name="goToEnterBtn" Content="Войти" FontSize="16" Width="100" Height="40" Margin="0,0,10,0" Background="#A86A65" Foreground="#3A2119" Click="GoToEnterBtn_Click"/>
                <Button x:Name="toAccountBtn" Content="Аккаунт" FontSize="16" Width="100" Height="40" Background="#A86A65" Foreground="#3A2119" Click="ToAccountBtn_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="10,5" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center" Margin="35, 15, 10, 10">
                <TextBlock Text="Мастер:" FontSize="16" VerticalAlignment="Center" Margin="0, 0, 15, 0"/>
                <ComboBox x:Name="masterCB" FontSize="15" Width="200" Height="30" SelectionChanged="MasterCB_SelectionChanged" DisplayMemberPath="FullName"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="5, 15, 10, 10">
                <TextBlock Text="Тип услуги:" FontSize="16" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <ComboBox x:Name="serviceTypeCB" FontSize="15" Width="200" Height="30" SelectionChanged="ServiceTypeCB_SelectionChanged" DisplayMemberPath="Name"/>
            </StackPanel>
        </Grid>

        <ListBox x:Name="servicesList" Grid.Row="2" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" Background="#D2E2EC" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="300" Height="500" Margin="10" Padding="10" BorderBrush="#3A2119" Background="#617891" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="300"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Image Grid.Row="0" Source="{Binding ImagePath}" Width="270" Height="300" Stretch="UniformToFill" Margin="0,0,0,5"/>
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Price, StringFormat=Цена: {0} ₽}" FontSize="14" Margin="0,5,0,0"/>
                                <TextBlock Text="{Binding MasterName, StringFormat=Мастер: }" FontSize="14" Margin="0,5,0,0"/>
                            </StackPanel>
                            
                            <Button Grid.Row="2" Content="Подробнее" FontSize="14" Background="#25344F" Foreground="#D9CBC2" Width="120" Height="35" HorizontalAlignment="Center" Margin="0,5,0,0" Click="DetailsBtn_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
