<Page x:Class="PR12.Pages.endPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="endPage">

    <Grid>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Вы проиграли :(" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" Margin="20" Foreground="#442D1C"/>
            <Button x:Name="restartBtn" Content="Начать заново" FontSize="19" Height="50" Width="170" HorizontalAlignment="Center" Click="restartBtn_Click" Background="#6B212C" Foreground="#D9CBC2"/>
        </StackPanel>
    </Grid>
</Page>
