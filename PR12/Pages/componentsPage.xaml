<Page x:Class="PR12.componentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="componentsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#3C507D">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Выбор комплектующих ПК" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" Margin="20" Foreground="#442D1C"/>
            <Button x:Name="backBtn" Grid.Column="1" Content="Назад" FontSize="17" Height="50" Width="130" Margin="0,10,20,10" Background="#6B212C" Foreground="#D9CBC2" Click="backBtn_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="20,15,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="searchBox" Grid.Column="0" Height="40" FontSize="14" VerticalContentAlignment="Center" TextChanged="searchBox_TextChanged"/>
            <ComboBox x:Name="manufacturerFilter" Grid.Column="2" Height="40" FontSize="14" VerticalContentAlignment="Center" Margin="10,0,0,0" DisplayMemberPath="name" SelectionChanged="manufacturerFilter_SelectionChanged"/>
        </Grid>

        <StackPanel Grid.Row="2"  Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="ALL" Tag="Все" Click="Category_Click" Background="#3C507D" Foreground="#D9CBC2" FontSize="14" Padding="18,6" Margin="5"/>

            <ItemsControl x:Name="categoryList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding name}" Tag="{Binding name}" Click="Category_Click" Background="#617891" Foreground="#D9CBC2" FontSize="14" Padding="18,6" Margin="5"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ListBox x:Name="partsList" Grid.Row="3" Margin="20" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="260" Margin="10" Padding="10" Background="#617891" BorderBrush="#3A2119" BorderThickness="1" CornerRadius="10">

                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="{Binding image}" Height="140" Stretch="UniformToFill" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding name}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding manufacturer_.name, StringFormat=Производитель: {0}}" FontSize="13" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding parttype_.name, StringFormat=Тип: {0}}" FontSize="13"/>
                            <TextBlock Text="{Binding price, StringFormat=Цена: {0} ₽}" FontSize="14" FontWeight="Bold" Margin="0,6,0,8"/>
                            <Button Content="Выбрать" Height="35" Background="#25344F" Foreground="#D9CBC2" Click="SelectPart_Click"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="nextBtn" Content="Далее" FontSize="17" Height="45" Width="120" Margin="0, 5, 0, 10" Background="#3C507D" Foreground="#D9CBC2" Click="nextBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
