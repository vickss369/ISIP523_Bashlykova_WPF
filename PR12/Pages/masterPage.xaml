<Page x:Class="PR12.Pages.masterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="masterPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#5C72A3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button x:Name="logoutBtn" Content="→ Выход" FontSize="17" Height="40" Width="100" Background="#C94736" Foreground="#3A2119" Grid.Column="0" HorizontalAlignment="Right" Margin="20,0,30,0" Click="logoutBtn_Click"/>
            <TextBlock x:Name="masterNameTBl" Text="ФИО Мастера" FontSize="21" FontWeight="Bold" Foreground="#3A2119" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1"/>
            <Button x:Name="updateServiceBtn" Content="Изменить свои услуги" FontSize="16" Width="190" Height="43" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,20,0" Background="#989876" Foreground="#3A2119" Click="EditServicesBtn_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="10,5" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center" Margin="20,15,10,10">
                <TextBlock Text="Дата:" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,8" Foreground="#3A2119"/>
                <DatePicker x:Name="datePicker" SelectedDateChanged="DatePicker_SelectedDateChanged" Width="150" Height="30"/>
            </StackPanel>
        </Grid>

        <ListBox x:Name="recordsList" Grid.Row="3" BorderThickness="0" Background="#D2E2EC" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True" HorizontalAlignment="Left"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="300" Height="510" Margin="10" Padding="10" BorderBrush="#3A2119" Background="{Binding CardColor}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="300"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Image Grid.Row="0" Source="{Binding ImagePath}" Width="270" Height="300" Stretch="UniformToFill" Margin="0,0,0,8"/>
                            
                            <StackPanel Grid.Row="1" Margin="0,4,0,5">
                                <TextBlock Text="{Binding ServiceName}" FontSize="17" FontWeight="Bold" Foreground="#3A2119" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Price, StringFormat=Цена: {0}₽}" FontSize="14" Foreground="#3A2119"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Row="2" Margin="0,6,0,8">
                                <TextBlock Text="{Binding ClientName, StringFormat=Клиент: {0}}" FontSize="14" Foreground="#3A2119"/>
                                <TextBlock Text="{Binding DateText}" FontSize="14" Foreground="#3A2119" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding TimeText}" FontSize="14" Foreground="#3A2119"/>
                            </StackPanel>
                            
                            <Button Grid.Row="3" Content="Подробнее" FontSize="14" Background="#25344F" Foreground="#D9CBC2" Width="130" Height="40" HorizontalAlignment="Center" Margin="0,10,0,0" Click="DetailsBtn_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
