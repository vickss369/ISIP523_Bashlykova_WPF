<Page x:Class="PR12.Pages.chosenRecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="chosenRecordPage">

    <Grid>
        <Border Margin="25" Padding="25" BorderBrush="#3A2119" BorderThickness="2" CornerRadius="12" Background="#D9CBC2" MaxWidth="700" MaxHeight="400">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#C4A39C" BorderBrush="#3A2119" BorderThickness="2" CornerRadius="8" Padding="5">
                    <Image Source="{Binding ImagePath}" Width="260" Height="260" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="25,0,0,0">
                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#3A2119" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ServiceTypeName, StringFormat=Тип услуги: }" FontSize="14" Foreground="#3A2119" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding MasterName, StringFormat=Мастер: }" FontSize="14" Foreground="#3A2119" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Price, StringFormat=Цена: {0} ₽}" FontSize="16" FontWeight="Bold" Foreground="#3A2119" Margin="0,5,0,0"/>

                    <TextBlock Text="{Binding DateText}" FontSize="15" Foreground="#3A2119" Margin="0,5,0,0"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StartTimeText}" FontSize="14" Foreground="#3A2119"/>
                        <TextBlock Text="–" FontSize="14" Foreground="#3A2119" Margin="5,0,5,0"/>
                        <TextBlock Text="{Binding EndTimeText}" FontSize="14" Foreground="#3A2119"/>
                    </StackPanel>

                    <TextBlock Text="Тип оплаты:" FontSize="15" Margin="0,10,0,3"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="cardRB" Content="Карта" FontSize="14" Margin="0,0,10,5" Checked="paymentTypeRB_Checked"/>
                        <RadioButton x:Name="cashRB" Content="Наличные" FontSize="14" Margin="0,0,10,5" Checked="paymentTypeRB_Checked"/>
                        <RadioButton x:Name="sbpRB" Content="СБП" FontSize="14" Margin="0,0,10,5" Checked="paymentTypeRB_Checked"/>
                    </StackPanel>

                    <TextBlock Text="Комментарий:" FontSize="15" Margin="0,10,0,3"/>
                    <TextBox x:Name="commentTB" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <StackPanel Orientation="Horizontal" Margin="23,20,0,15" HorizontalAlignment="Center">
                        <Button x:Name="backBtn" Content="← Назад" FontSize="16" Width="100" Height="40" Background="#B4776E" Click="backBtn_Click"/>
                        <Button x:Name="recordBtn" Content="Записаться"  FontSize="16" Width="130" Height="40" Margin="20,0,0,0" Background="#8BA2C1" Click="recordBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
