<Page x:Class="PR12.Pages.chosenRecordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="chosenRecordPage">

    <Grid>
        <Border Margin="20" Padding="10" BorderBrush="#3A2119" BorderThickness="2" CornerRadius="12" Background="#D9CBC2" MaxWidth="700" MaxHeight="450" Height="410">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#C4A39C" BorderBrush="#3A2119" BorderThickness="2" CornerRadius="8" Width="300" Height="300" Padding="5">
                    <Image Source="{Binding ImagePath}" Width="270" Height="270" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="25,0,0,0">
                    <TextBlock Text="{Binding ServiceName}" FontSize="18" FontWeight="Bold" Foreground="#3A2119" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ServiceTypeName, StringFormat=Тип услуги: {0}}" FontSize="14" Foreground="#3A2119"/>
                    <TextBlock Text="{Binding UserLabel}" FontSize="14" Foreground="#3A2119" Margin="0,8,0,0"/>
                    <TextBlock x:Name="phoneTBl" Text="{Binding UserPhone, StringFormat=Телефон: }" FontSize="14" Foreground="#3A2119"/>

                    <TextBlock Text="{Binding Price, StringFormat=Цена: {0} ₽}" FontSize="16" FontWeight="Bold" Foreground="#3A2119" Margin="0,12,0,0"/>
                    <TextBlock Text="{Binding DateText}" FontSize="15" Foreground="#3A2119" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding StartTimeText}" FontSize="14" Foreground="#3A2119"/>
                        <TextBlock Text="–" FontSize="14" Foreground="#3A2119" Margin="5,0,5,0"/>
                        <TextBlock Text="{Binding EndTimeText}" FontSize="14" Foreground="#3A2119"/>
                    </StackPanel>

                    <StackPanel x:Name="clientPanel" Margin="0,12,0,0">
                        <TextBlock Text="Тип оплаты:" FontSize="15" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="cardRB" Content="Карта" FontSize="14" Margin="0,0,12,0" Checked="paymentTypeRB_Checked"/>
                            <RadioButton x:Name="cashRB" Content="Наличные" FontSize="14" Margin="0,0,12,0" Checked="paymentTypeRB_Checked"/>
                            <RadioButton x:Name="sbpRB" Content="СБП" FontSize="14" Margin="0,0,12,0" Checked="paymentTypeRB_Checked"/>
                        </StackPanel>
                        
                        <TextBlock Text="Комментарий:" FontSize="15" Margin="0,10,0,0"/>
                        <TextBox x:Name="commentTB" Height="40" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,25,0,0" HorizontalAlignment="Center">
                        <Button x:Name="backBtn" Content="← Назад" FontSize="16" Width="110" Height="40" Background="#B4776E" Click="backBtn_Click"/>
                        <Button x:Name="actionBtn" FontSize="16" Width="170" Height="40" Margin="20,0,0,0" Click="actionBtn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
