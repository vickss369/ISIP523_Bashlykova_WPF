<Page x:Class="PR12.Pages.managerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="managerPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#5C72A3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="managerNameTBl" Text="ФИО менеджера" FontSize="20" FontWeight="Bold" Foreground="#3A2119" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Button x:Name="logoutBtn" Content="→ Выход" FontSize="16" Height="35" Width="100" Background="#C94736" Foreground="#3A2119" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Click="logoutBtn_Click"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30,0,0">
            <Button x:Name="servicesBtn" Content="Услуги" Width="90" Height="35" FontSize="15" Margin="6" Background="#D4A5BB" Foreground="#3A2119" Click="servicesBtn_Click"/>
            <Button x:Name="productsBtn" Content="Товары" Width="90" Height="35" FontSize="15" Margin="6" Background="#FFE5B4" Foreground="#3A2119" Click="productsBtn_Click"/>
            <Button x:Name="recordsBtn" Content="Записи" Width="90" Height="35" FontSize="15" Margin="6" Background="#d69b95" Foreground="#3A2119" Click="recordsBtn_Click"/>
            <Button x:Name="ordersBtn" Content="Заказы" Width="90" Height="35" FontSize="15" Margin="6" Background="#BFD397" Foreground="#3A2119" Click="ordersBtn_Click"/>
            <Button x:Name="manufacturersBtn" Content="Производители" Width="140" Height="35" FontSize="15" Margin="6" Background="#B4A3D7" Foreground="#3A2119" Click="manufacturersBtn_Click"/>
            <Button x:Name="productTypesBtn" Content="Типы товаров" Width="110" Height="35" FontSize="15" Margin="6" Background="#dab186" Foreground="#3A2119" Click="productTypesBtn_Click"/>
            <Button x:Name="serviceTypesBtn" Content="Типы услуг" Width="90" Height="35" FontSize="15" Margin="6" Background="#60A1AF" Foreground="#3A2119" Click="serviceTypesBtn_Click"/>
        </StackPanel>

        <ListBox x:Name="managerList" Grid.Row="2" Margin="15" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="300" Height="450" Margin="10" CornerRadius="12" Background="{Binding CardColor}" BorderBrush="#3A2119" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="250"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="60"/>
                            </Grid.RowDefinitions>

                            <Image Grid.Row="0" Source="{Binding ImagePath}" Margin="15,15,15,0" Stretch="UniformToFill" Visibility="{Binding ImageVisibility}"/>

                            <Grid Grid.Row="1" Margin="20,5,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="17" FontWeight="Bold" Foreground="#3A2119" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="{Binding TypeInfo}" FontSize="14" Foreground="#3A2119" Visibility="{Binding TypeVisibility}"/>
                                <TextBlock Grid.Row="2" Text="{Binding PriceText}" FontSize="14" Foreground="#3A2119" Visibility="{Binding PriceVisibility}"/>
                                <TextBlock Grid.Row="3" Text="{Binding ClientText}" FontSize="14" Margin="0,6,0,0" Foreground="#3A2119" Visibility="{Binding ClientVisibility}"/>
                                <TextBlock Grid.Row="4" Text="{Binding DateText}" FontSize="14" Foreground="#3A2119" Visibility="{Binding DateVisibility}"/>
                                <TextBlock Grid.Row="5" Text="{Binding ExtraInfo}" FontSize="13" Margin="0,6,0,0" Foreground="#3A2119" TextWrapping="Wrap"/>
                            </Grid>

                            <Button Grid.Row="2" x:Name="actionBtn" Content="{Binding ActionText}" FontSize="15" Width="120" Height="35" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,20" Background="{Binding ButtonColor}" Foreground="#3A2119" Click="actionBtn_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
