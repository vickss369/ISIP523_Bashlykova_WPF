<Page x:Class="PR12.Pages.gamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="gamePage">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Roguelike-игра от vickss :)" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#442D1C"/>
        <Grid Grid.Row="1" Margin="0,20,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="30,0,0,0">
                <TextBlock Text="Этап: " FontSize="18" FontWeight="Bold" Foreground="#442D1C"/>
                <TextBlock x:Name="stepTBl" Text="1" FontSize="18" Foreground="#442D1C" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,70,0">
                <TextBlock Text="Здоровье: " FontSize="18" FontWeight="Bold" Foreground="#442D1C"/>
                <TextBlock x:Name="HPTBl" Text="100" FontSize="18" Foreground="#442D1C" Margin="5,0,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10">
            <Image x:Name="gameBackground" Source="/Image/cave.jpg" Stretch="Fill"/>

            <ItemsControl x:Name="heroesImagesPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding}" Stretch="Uniform" MaxHeight="200" Margin="10"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10">
                <Button x:Name="redBtn" Content="Атака" FontSize="16" Width="110" Height="35" Margin="10" Background="#6B212C" Foreground="#D9CBC2" Click="Btns_Click"/>
                <Button x:Name="greenBtn" Content="Защита" FontSize="16" Width="110" Height="35" Margin="10" Background="#64854C" Foreground="#D9CBC2" Click="Btns_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="5" CornerRadius="10" BorderBrush="#442D1C" BorderThickness="2" Background="#849AAD">
                <StackPanel Margin="15,15,0,10">
                    <TextBlock Text="Инвентарь" FontSize="18" FontWeight="Bold" Foreground="#442D1C" Margin="0,0,0,10"/>

                    <TextBlock Text="Оружие:" FontSize="16" FontWeight="Bold" Foreground="#442D1C" Margin="5,0,0,3"/>
                    <TextBlock x:Name="weaponTBl" FontSize="15" Text="Нет" Margin="10,0,0,15" Foreground="#442D1C"/>

                    <TextBlock Text="Доспех:" FontSize="16" FontWeight="Bold" Foreground="#442D1C" Margin="5,0,0,3"/>
                    <TextBlock x:Name="protectTBl" FontSize="15" Text="Нет" Foreground="#442D1C" Margin="10,0,0,10"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="5" CornerRadius="10" BorderBrush="#442D1C" BorderThickness="2" Background="#F5E9DC">
                <Grid Margin="10">
                    <TextBlock Text="Журнал событий" FontSize="18" FontWeight="Bold" Foreground="#442D1C" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <ScrollViewer Margin="0,30,0,0" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="logTBl" TextWrapping="Wrap" Foreground="#442D1C" FontSize="15"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
