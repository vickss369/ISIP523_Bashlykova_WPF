<Page x:Class="PR12.Pages.gamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="gamePage">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Roguelike-игра от vickss :)" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="10" Foreground="#442D1C"/>
        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="Этап: " FontSize="18" FontWeight="Bold" Foreground="#442D1C"/>
                <TextBlock x:Name="stepTBl" Text="1" FontSize="18" Foreground="#442D1C" Margin="5,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Здоровье: " FontSize="18" FontWeight="Bold" Foreground="#442D1C"/>
                <TextBlock x:Name="HPTBl" Text="100" FontSize="18" Foreground="#442D1C" Margin="5,0,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10">
            <Image x:Name="gameBackground" Source="/Image/cave.jpg" Stretch="Fill"/>
            <Image x:Name="gameHero" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10">
                <Button x:Name="attackBtn" Content="Атака" FontSize="16" Width="110" Height="35" Margin="10" Background="#6B212C" Foreground="#D9CBC2"/>
                <Button x:Name="defendBtn" Content="Защита" FontSize="16" Width="110" Height="35" Margin="10" Background="#64854C" Foreground="#D9CBC2"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="5" CornerRadius="10" BorderBrush="#442D1C" BorderThickness="2" Background="#F5E9DC">
                <StackPanel Margin="10">
                    <TextBlock Text="Инвентарь" FontSize="18" FontWeight="Bold" Foreground="#442D1C" Margin="0,0,0,10"/>

                    <TextBlock Text="Оружие:" FontWeight="Bold" Foreground="#442D1C"/>
                    <TextBlock x:Name="weaponTBl" Text="Нет" Margin="0,0,0,10" Foreground="#442D1C"/>

                    <TextBlock Text="Доспех:" FontWeight="Bold" Foreground="#442D1C"/>
                    <TextBlock x:Name="armorTBl" Text="Нет" Foreground="#442D1C"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Margin="5" CornerRadius="10" BorderBrush="#442D1C" BorderThickness="2" Background="#F5E9DC">
                <StackPanel Margin="10">
                    <TextBlock Text="Журнал событий" FontSize="18" FontWeight="Bold" Foreground="#442D1C" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="logTBl" TextWrapping="Wrap" Foreground="#442D1C" FontSize="14"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
