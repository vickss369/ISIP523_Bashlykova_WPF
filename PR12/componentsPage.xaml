<Page x:Class="PR12.componentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="componentsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#3C507D">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Выбор комплектующих ПК" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" Foreground="#D9CBC2"/>
            <Button x:Name="backBtn" Grid.Column="1" Content="Назад" FontSize="17" Height="50" Width="130" Margin="0,10,20,10" Background="#6B212C" Foreground="#D9CBC2" Click="backBtn_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="searchBox" Height="36" FontSize="14" Margin="0,0,0,10" VerticalContentAlignment="Center" TextChanged="searchBox_TextChanged"/>
            <ComboBox x:Name="manufacturerFilter" Grid.Row="1" Height="36" Margin="0,0,0,15" SelectionChanged="manufacturerFilter_SelectionChanged"/>

            <ListBox x:Name="partsList" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="260" Margin="10" Padding="10" BorderBrush="#3A2119" Background="#617891" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Image Source="{Binding image}" Height="150" Stretch="UniformToFill" Margin="0,0,0,8"/>
                                <StackPanel Grid.Row="1">
                                    <TextBlock Text="{Binding name}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding manufacturer_.name, StringFormat=Производитель: {0}}" FontSize="13" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding parttype_.name, StringFormat=Тип: {0}}" FontSize="13"/>
                                    <TextBlock Text="{Binding price, StringFormat=Цена: {0} ₽}" FontSize="14" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>

                                <Button Grid.Row="2" Content="Выбрать" Height="35" Margin="0,10,0,0" Background="#25344F" Foreground="#D9CBC2" Click="SelectPart_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
            <Button x:Name="nextBtn" Content="Далее" FontSize="17" Height="50" Width="150" Margin="10" Background="#3C507D" Foreground="#D9CBC2" Click="nextBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
