<Page x:Class="PR12.accountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="accountPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#3C507D">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Аккаунт" FontSize="20" FontWeight="Bold" Foreground="#3A2119" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Фильмы" FontSize="16" Width="100" Height="40" Margin="0,0,30,0" Background="#A86A65" Foreground="#3A2119" BorderBrush="#3A2119" Click="goTofilms_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="10">
                <TextBlock Text="Информация" FontSize="20" FontWeight="Bold" Foreground="#3A2119" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="Имя пользователя:" FontSize="16" Foreground="#3A2119"/>
                <TextBlock x:Name="UserNameTB" FontSize="17" Foreground="#3A2119" Margin="10,0,0,15"/>
            </StackPanel>
            
            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="7">
                <TextBlock Grid.Column="1" Text="Билеты" FontSize="20" FontWeight="Bold" Foreground="#3A2119" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,15"/>
                <ListBox x:Name="ticketsList" Grid.Column="1" BorderThickness="0" Background="#D2E2EC" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10" Padding="15" BorderBrush="#3A2119" BorderThickness="2" CornerRadius="10" Background="#D9CBC2">
                                <StackPanel>
                                    <TextBlock Text="{Binding FilmName, StringFormat=Фильм: {0}}" FontSize="17"/>
                                    <TextBlock Text="{Binding HallName, StringFormat=Зал: {0}}" FontSize="16"/>
                                    <TextBlock Text="{Binding SessionDate, StringFormat=Дата сеанса: {0:dd.MM.yyyy}}" FontSize="16"/>
                                    <TextBlock Text="{Binding Price, StringFormat=Стоимость: {0}₽}" FontSize="17" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
