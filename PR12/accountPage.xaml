<Page x:Class="PR12.accountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="accountPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Аккаунт" FontSize="20" HorizontalAlignment="Center" Margin="50, 0, 0, 0"/>
            <Button Grid.Column="1" x:Name="toakkBtn" Content="Фильмы" FontSize="16" Width="100" Height="40" Margin="0,0,20,0" VerticalAlignment="Center" Click="goTofilms_Click"/>
        </Grid>
    </Grid>
</Page>
