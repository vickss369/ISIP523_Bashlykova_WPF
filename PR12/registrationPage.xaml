<Page x:Class="PR12.registrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="registrationPage">

    <Grid>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ВХОД" FontSize="20" HorizontalAlignment="Center" Margin="20"/>
            <StackPanel Orientation="Horizontal" Margin="35,15,0,0">
                <TextBlock Text="Имя пользователя: " FontSize="17" HorizontalAlignment="Center" Margin="170, 0, 0, 0"/>
                <TextBox x:Name="userNameBtn" FontSize="15" Margin="8, 0, 0, 14" Width="250" Height="30"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="35,15,0,0">
                <TextBlock Text="Пароль: " FontSize="17" HorizontalAlignment="Center" Margin="170, 0, 0, 0"/>
                <TextBox x:Name="passwordBtn" FontSize="15" Margin="8, 0, 0, 14" Width="250" Height="30"/>
            </StackPanel>
            <Button x:Name="entrBtn" Content="Войти" FontSize="18" Height="50" Width="130" HorizontalAlignment="Center" Margin="20" Click="enterFilms_Click"/>
        </StackPanel>
    </Grid>
</Page>
