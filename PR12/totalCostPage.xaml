<Page x:Class="PR12.totalCostPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="totalCostPage">

    <Grid>
        <StackPanel>
            <TextBlock Text="Расчёт итоговой стоимости" 
                   FontSize="18" 
                   HorizontalAlignment="Center" 
                   Margin="20"/>

            <StackPanel Orientation="Horizontal" Margin="20,10,0,0">
                <TextBlock Text="Выбранный автомобиль:" FontSize="15" Margin="7"/>
                <TextBlock x:Name="chosenAutoFull" FontSize="15" Margin="7"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="20,10,0,0">
                <TextBlock Text="Выбранный двигатель:" FontSize="15" Margin="7"/>
                <TextBlock x:Name="chosenEngineFull" FontSize="15" Margin="7"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="20,10,0,0">
                <TextBlock Text="Выбранный цвет:" FontSize="15" Margin="7"/>
                <TextBlock x:Name="chosenColorFull" FontSize="15" Margin="7"/>
            </StackPanel>


            <StackPanel Orientation="Horizontal" Margin="20,10,0,0">
                <TextBlock Text="Дополнительные опции:" FontSize="15" Margin="7"/>
                <TextBlock x:Name="chosenDopFull" FontSize="15" Margin="7" Width="350" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="20,25,0,0">
                <TextBlock Text="ИТОГО:" FontSize="16" Margin="7"/>
                <TextBlock x:Name="totalFull" FontSize="16" Margin="7"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,30" HorizontalAlignment="Center">
                <Button x:Name="backButton" Content="Назад" Width="120" Height="40" Click="back_Click"/>
                <Button x:Name="nextButton" Content="Далее" Width="120" Height="40" Margin="20,0" Click="next_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
