<Page x:Class="PR12.buildSummaryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="buildSummaryPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#3C507D">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Итоговый просмотр сборки" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" Margin="20" Foreground="#442D1C"/>
            <Button x:Name="backBtn" Grid.Column="1" Content="Назад" FontSize="17" Height="50" Width="130" Margin="0,10,20,10" Background="#6B212C" Foreground="#D9CBC2" Click="backBtn_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="selectedPartsList" Grid.Column="0" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" Padding="10" Width="360" Background="#F9F7F6" BorderBrush="#3A2119" BorderThickness="2" CornerRadius="5" HorizontalAlignment="Stretch">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <Image Source="{Binding image}" VerticalAlignment="Top" Stretch="Uniform" MaxHeight="100" Grid.Column="0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding name}" FontWeight="Bold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding manufacturer_.name, StringFormat=Производитель: {0}}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding parttype_.name, StringFormat=Тип: {0}}" FontSize="12"/>
                                    <TextBlock Text="{Binding price, StringFormat=Цена: {0} ₽}" FontWeight="Bold" Margin="0,6,0,0"/>
                                </StackPanel>
                                <Button Content="Удалить" FontSize="14" Width="70" Height="35" Grid.Column="2" VerticalAlignment="Center" Margin="15,0,10,0" Background="#A86A65" Foreground="#000000" BorderBrush="#3A2119" Click="removeBtn_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="2" Background="#D59FA5" BorderBrush="#3A2119" BorderThickness="3" CornerRadius="5" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="10,0,0,0">
                    <TextBlock Text="Стоимость сборки" FontSize="18" FontWeight="Bold" Margin="0,10,0,0"/>
                    <TextBlock x:Name="totalPriceTBl" Text="aaa" FontSize="19" FontWeight="Bold" Foreground="#6B212C" Margin="10,0,0,15"/>
                    
                    <TextBlock Text="Совместимость" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBlock x:Name="compatibilityTBl" Text="aaa" TextWrapping="Wrap" FontSize="15" Margin="5,5,0,20"/>
                    
                    <TextBlock Text="Название сборки" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBox x:Name="buildNameTB" TextWrapping="Wrap" Height="25" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,5,10,13"/>
                    
                    <TextBlock Text="Автор сборки" FontSize="16" FontWeight="Bold" Margin="0,5,0,0"/>
                    <TextBox x:Name="authorTB" TextWrapping="Wrap" Height="25" FontSize="14" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,5,10,20"/>
                    
                    <Button x:Name="saveBtn" Content="Сохранить сборку" FontSize="14" Height="40" Width="138" HorizontalAlignment="Center" Background="#3C507D" Foreground="#D9CBC2" Margin="0,0,0,20" Click="saveBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
