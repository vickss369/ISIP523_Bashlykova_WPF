<Page x:Class="PR12.chosenFilmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="chosenFilmPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Grid Grid.Row="0" Background="#D2E2EC">
            <Button Content="← К фильмам" Width="120" Height="40" FontSize="16" Margin="50,0,50,0" HorizontalAlignment="Right" Background="#A86A65" Foreground="#000000" BorderBrush="#3A2119" Click="backToFilms_Click"/>
        </Grid>

        <!-- Центральная часть -->
        <Grid Grid.Row="1" Margin="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Постер -->
            <Image x:Name="FilmImage" Grid.Column="0" Width="280" Height="480" Stretch="UniformToFill" Margin="0,0,20,0"/>

            <!-- Информация -->
            <StackPanel Grid.Column="1" Orientation="Vertical">
                <TextBlock x:Name="FilmNameTB" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,15"/>
                <TextBlock x:Name="DescriptionTB" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,20"/>
                <TextBlock x:Name="GenreTB" FontSize="15" Margin="0,0,0,10"/>
                <TextBlock x:Name="RatingTB" FontSize="15" Margin="0,0,0,10"/>
                <TextBlock x:Name="AgeRatingTB" FontSize="15" Margin="0,0,0,10"/>
                <TextBlock x:Name="StartDateTB" FontSize="15" Margin="0,0,0,10"/>
            </StackPanel>
        </Grid>

        <!-- Нижняя кнопка -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="130,10,0,20">
            <Button x:Name="buyTicketBtn" Content="Купить билеты" FontSize="17" Width="155" Height="45" Background="#A86A65" Foreground="#000000" BorderBrush="#3A2119" Click="buyTicket_Click"/>
        </StackPanel>
    </Grid>
</Page>
