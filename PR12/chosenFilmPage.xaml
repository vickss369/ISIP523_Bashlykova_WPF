<Page x:Class="PR12.chosenFilmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="chosenFilmPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>

        <StackPanel  Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
            <Button x:Name="toregistrBtn" Content="Войти" FontSize="16" Width="90" Height="35" Margin="0,10,15,0" Background="#A86A65" Foreground="#000000" BorderBrush="#3A2119" Click="goToReg_Click"/>
            <Button Content="← К фильмам" Width="110" Height="35" FontSize="14" Margin="0,10,50,0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#A86A65" Foreground="#000000" BorderBrush="#3A2119" Click="backToFilms_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="25" Padding="20" BorderBrush="#3A2119" BorderThickness="1" CornerRadius="12" Background="#617891">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#3A2119" BorderThickness="1" CornerRadius="6" Padding="5" Background="#6B212C">
                        <Image x:Name="FilmImage" Width="240" Height="340" Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="20,0,0,0">
                        <TextBlock x:Name="FilmNameTB" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DescriptionTB" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,15"/>
                        <TextBlock x:Name="GenreTB" FontSize="15" Margin="0,0,0,10"/>
                        <TextBlock x:Name="RatingTB" FontSize="15" Margin="0,0,0,10"/>
                        <TextBlock x:Name="AgeRatingTB" FontSize="15" Margin="0,0,0,10"/>
                        <TextBlock x:Name="StartDateTB" FontSize="15" Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Padding="15" CornerRadius="8" Background="#F5EFEB">
                    <StackPanel>
                        <TextBlock Text="Сеансы" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ListBox x:Name="sessionsList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#3A2119" BorderThickness="1" CornerRadius="6" Padding="8" Width="250" Height="70" Margin="0,5" Background="#849DBB">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="{Binding SessionDate, StringFormat=Дата: {0:dd.MM.yyyy}}" FontSize="16"/>
                                                <TextBlock Text="{Binding Halls.HallRating.Nomination, StringFormat=Зал: {0}}" FontSize="15"/>
                                            </StackPanel>
                                            <Button Content="Выбрать" Grid.Column="1" Width="90" Height="35" FontSize="14" Margin="10,0,7,0" Background="#A86A65" Foreground="#000000" BorderBrush="#3A2119" Click="ChooseSession_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
