<Page x:Class="PR12.chosenFilmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="chosenFilmPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="55"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#D2E2EC">
            
        </Grid>

        <StackPanel  Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
            <Button x:Name="toregistrBtn" Content="Войти" FontSize="16" Width="90" Height="35" Margin="0,10,15,0" Background="#A86A65" Foreground="#000000" BorderBrush="#3A2119" Click="goToReg_Click"/>
            <Button Content="← К фильмам" Width="110" Height="35" FontSize="14" Margin="0,10,50,0" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#A86A65" Foreground="#000000" BorderBrush="#3A2119" Click="backToFilms_Click"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="30" Padding="20" BorderBrush="#3A2119" BorderThickness="1" CornerRadius="10" Background="#617891">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="FilmImage" Grid.Column="0" Width="250" Height="360" Stretch="UniformToFill" Margin="0,0,25,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top">
                    <TextBlock x:Name="FilmNameTB" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DescriptionTB" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,15"/>
                    <TextBlock x:Name="GenreTB" FontSize="15" Margin="0,0,0,10"/>
                    <TextBlock x:Name="RatingTB" FontSize="15" Margin="0,0,0,10"/>
                    <TextBlock x:Name="AgeRatingTB" FontSize="15" Margin="0,0,0,10"/>
                    <TextBlock x:Name="StartDateTB" FontSize="15" Margin="0,0,0,20"/>
                    <TextBlock x:Name="SessionsTB" FontSize="16" Margin="0,0,0,10"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="50,0,0,20">
            <Button x:Name="buyTicketBtn" Content="Купить билеты" FontSize="15" Width="145" Height="38" Background="#A86A65" Foreground="#000000" BorderBrush="#3A2119" Click="buyTicket_Click"/>
        </StackPanel>
    </Grid>
</Page>
