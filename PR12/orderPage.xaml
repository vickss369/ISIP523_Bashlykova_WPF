<Page x:Class="PR12.orderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="orderPage">

    <Grid>
        <StackPanel>
            <TextBlock Text="Оформление заказа" FontSize="18" HorizontalAlignment="Center" Margin="20"/>

            <StackPanel Orientation="Horizontal" Margin="35,5,0,0">
                <TextBlock Text="Имя:" FontSize="16" Margin="7"/>
                <TextBox x:Name="userName" FontSize="16" Margin="7" Width="250"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="35,5,0,0">
                <TextBlock Text="Телефон:" FontSize="16" Margin="7"/>
                <TextBox x:Name="userPhone" FontSize="16" Margin="7" Width="250" PreviewTextInput="userPhone_PreviewTextInput"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="35,5,0,0">
                <TextBlock Text="Электронная почта:" FontSize="16" Margin="7"/>
                <TextBox x:Name="userEmail" FontSize="16" Margin="7" Width="250"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,30" HorizontalAlignment="Center">
                <Button x:Name="backButton" Content="Назад" Width="120" Height="40" Click="back_Click"/>
                <Button x:Name="finishButton" Content="Отправить заявку" Width="120" Height="40" Margin="20,0" Click="finish_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
