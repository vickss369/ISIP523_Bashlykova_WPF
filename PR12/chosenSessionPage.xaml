<Page x:Class="PR12.chosenSessionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="chosenSessionPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#3C507D">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock x:Name="FilmNameTB" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="AgeRatingTB" FontSize="15" Margin="0,5,0,0"/>
                <TextBlock x:Name="StartDateTB" FontSize="15" Margin="0,5,0,0"/>
                <TextBlock x:Name="SessionTB" FontSize="15" Margin="0,5,0,0"/>
            </StackPanel>

            <Button x:Name="backBtn" Content="Назад" FontSize="16" Width="100" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#A86A65" Foreground="#3A2119" BorderBrush="#3A2119" Click="goToSession_Click"/>
        </Grid>

        <ListBox x:Name="placesList" Grid.Row="1" Margin="20" BorderThickness="0" Background="Transparent">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding PlaceNumber}" Width="60" Height="60" Margin="5"
                        Background="{Binding Status}" Foreground="White" FontWeight="Bold"
                        Click="Place_Click"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="selectedPlacePanel" Grid.Row="2" Margin="20" Padding="15" Background="#617891" CornerRadius="8" Visibility="Collapsed">
            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="SelectedPlaceTB" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="SelectedHallTB" FontSize="15"/>
                <TextBlock x:Name="SelectedDateTB" FontSize="15" Margin="0,0,0,10"/>
                <Button x:Name="buyTicketBtn" Content="Оформить билет" Width="180" Height="40" FontSize="16" Background="#A86A65" Foreground="#000000" BorderBrush="#3A2119" Click="buyTicketBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
