<Page x:Class="PR12.chosenSessionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="#D2E2EC"
      Title="chosenSessionPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#3C507D">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="20,0,0,0">
                <TextBlock x:Name="FilmNameTB" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="AgeRatingTB" FontSize="15" Margin="0,0,0,10"/>
                <TextBlock x:Name="StartDateTB" FontSize="15" Margin="0,0,0,10"/>
                <TextBlock x:Name="SessionTB" FontSize="15" Margin="0,0,0,10"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1" Margin="0,20,20,0" VerticalAlignment="Top">
                <Button x:Name="backBtn" Content="Назад" FontSize="16" Width="100" Height="40" Margin="0,0,10,0" Background="#A86A65" Foreground="#3A2119" Click="goToSession_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
