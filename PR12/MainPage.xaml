<Page x:Class="PR12.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="ГЛАВНАЯ СТРАНИЦА" FontSize="21" HorizontalAlignment="Center" Margin="20"/>
            <Button x:Name="filmsBtn" Content="Посмотреть фильмы →" FontSize="16" Height="50" Width="200" HorizontalAlignment="Center" Click="goToFilms_OnClick"/>
            <Button x:Name="registrBtn" Content="Вход / регистрация" FontSize="16" Height="50" Width="200" HorizontalAlignment="Center" Margin="20" Click="registr_OnClick"/>
        </StackPanel>
    </Grid>
</Page>
