<Page x:Class="PR12.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PR12"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <StackPanel>
            <TextBlock Text="ГЛАВНАЯ СТРАНИЦА" FontSize="21" HorizontalAlignment="Center" Margin="20"/>
            <Button x:Name="engineButton" Content="К оформлению заказа →" FontSize="15" Height="50" Width="200" HorizontalAlignment="Center" Click="engineButton_OnClick"/>
            <Button x:Name="bckToOrderButton" Content="Вернуться к оформлению заказа →" FontSize="15" Height="50" Width="265" HorizontalAlignment="Center" Margin="20" Click="bckToOrderButton_OnClick"/>
        </StackPanel>
    </Grid>
</Page>
